APP_NAME=Brzisajt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sr
APP_FALLBACK_LOCALE=sr
APP_FAKER_LOCALE=sr_Latn_RS
APP_TIMEZONE=Europe/Belgrade

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@brzisajt.rs"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Brzisajt ---
# Administratora pravi seeder (php artisan db:seed --class=AdminSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrator"

# Kome se šalju upiti (odvojeno zarezom)
ORDER_NOTIFY_EMAILS=filip@otlr.digital

# Podrazumevane vrednosti; menjaju se u admin panelu → Podešavanja
BRZI_BASE_PRICE=600
BRZI_EXTRA_LOGO_PRICE=200
BRZI_EXTRA_SEO_PRICE=400
BRZI_PHONE="+381 63 115 0495"
BRZI_EMAIL=filip@otlr.digital
BRZI_VIBER=
BRZI_WHATSAPP=

# Analitika: none | plausible | ga4 (GA4 se učitava tek uz saglasnost za kolačiće)
ANALYTICS_DRIVER=none
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
GA4_MEASUREMENT_ID=

# Telegram obaveštenja o upitima — isključena dok nisu podešene obe vrednosti
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Antispam
BRZI_MIN_FILL_SECONDS=8
BRZI_RATE_LIMIT=5
# none | turnstile
CAPTCHA_DRIVER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
